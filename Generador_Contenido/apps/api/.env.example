# Configuración de Llaves para la Arquitectura Híbrida UEI

# DeepSeek API (Validador, Concordancia y Lúdicas MCP)
DEEPSEEK_API_KEY=tu_deepseek_api_key_aqui
DEEPSEEK_MODEL=deepseek-chat
