# Required for the resource-generation step (/generate) — set GEMINI_API_KEY or ANTHROPIC_API_KEY.
# Without a key, /analyze still works normally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5

# Provider selection: "gemini" or "anthropic" (auto-detects if omitted based on available API key)
LLM_PROVIDER=gemini

