# DeepSeek API Key (Recommended for Validador, Concordancia & Lúdicas MCP)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini API Key (Recommended for Visión & Digitalización PDF)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic API Key (Opcional)
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-4-6

# OpenRouter API Key (Opcional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# LLM Provider: "deepseek", "gemini", "openrouter", "anthropic" (auto-detects if omitted)
LLM_PROVIDER=deepseek
